+	// Image zoom opens a real window rather than an in-app overlay: it can be
+	// moved to another monitor, maximized, and resized past the transcript
+	// column. The shell is loaded first and the picture injected afterwards —
+	// a data: URL carrying the image would blow past Chromium's 2MB navigation
+	// limit for large screenshots.
+	ipcMain.handle(
+		IPC_COMMANDS.SYSTEM_OPEN_IMAGE_WINDOW,
+		async (event, payload: IpcOpenImageWindowPayload): Promise<void> => {
+			const dataUrl = typeof payload?.dataUrl === "string" ? payload.dataUrl : "";
+			if (!/^data:image\/[a-z0-9.+-]+;base64,[A-Za-z0-9+/=]+$/i.test(dataUrl)) return;
+			const parent = BrowserWindow.fromWebContents(event.sender);
+			const imageWindow = new BrowserWindow({
+				width: 1100,
+				height: 820,
+				minWidth: 360,
+				minHeight: 260,
+				title: typeof payload.title === "string" && payload.title.trim() ? payload.title : "omp",
+				autoHideMenuBar: true,
+				backgroundColor: "#0b0b0b",
+				...(parent ? { parent } : {}),
+				webPreferences: { contextIsolation: true, nodeIntegration: false, sandbox: true },
+			});
+			imageWindow.webContents.setWindowOpenHandler(() => ({ action: "deny" }));
+			const page = [
+				'<!doctype html><meta charset="utf-8">',
+				"<style>html,body{margin:0;height:100%;background:#0b0b0b;display:flex;",
+				"align-items:center;justify-content:center}img{max-width:100%;max-height:100%;",
+				"object-fit:contain}</style><img id=\"omp-zoom\" alt=\"\">",
+			].join("");
+			await imageWindow.loadURL(`data:text/html;charset=utf-8,${encodeURIComponent(page)}`);
+			await imageWindow.webContents.executeJavaScript(
+				`document.getElementById("omp-zoom").src = ${JSON.stringify(dataUrl)};`,
+			);
+		},
+	);
+
