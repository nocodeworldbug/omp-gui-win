@@ -196,5 +196,14 @@ export function createMenu(windowManager: WindowManager, spawnWindow: SpawnWindo
 		},
 	];
 
-	Menu.setApplicationMenu(Menu.buildFromTemplate(template));
+	// Windows: drop the native menu bar entirely. `autoHideMenuBar` keeps a
+	// hidden bar that Alt activates, which steals focus from the composer on
+	// every Alt-based chord (Alt+Shift input-source switching being the common
+	// one) and visibly deselects the input. macOS keeps its menu (the app is
+	// expected to have one, and it owns no focus here).
+	if (process.platform !== "win32") {
+		Menu.setApplicationMenu(Menu.buildFromTemplate(template));
+	} else {
+		Menu.setApplicationMenu(null);
+	}
 }
