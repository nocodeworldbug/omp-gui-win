+/**
+ * Resolve a sidecar candidate, accepting the platform's `.exe` suffix: Windows
+ * ships the binary as `omp.exe` while mac/linux use a bare `omp`.
+ */
+function resolveOmpCandidate(candidate: string): string | null {
+	if (existsSync(candidate)) return candidate;
+	const exe = `${candidate}.exe`;
+	return existsSync(exe) ? exe : null;
