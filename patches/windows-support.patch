diff --git a/electron-builder.win.yml b/electron-builder.win.yml
new file mode 100644
index 0000000..c3b5911
--- /dev/null
+++ b/electron-builder.win.yml
@@ -0,0 +1,46 @@
+appId: sh.omp.gui
+productName: omp
+directories:
+  buildResources: resources
+  output: dist
+files:
+  - out/**/*
+  - "!node_modules/**/*"
+extraResources:
+  # Windows sidecar is `omp.exe`; the main process resolves the .exe suffix.
+  - from: resources/omp.exe
+    to: omp.exe
+asar: true
+compression: maximum
+
+win:
+  # electron-builder converts this 1024px PNG into the multi-size .ico it needs,
+  # so the repo carries no checked-in .ico (upstream ships only .icns/.png).
+  icon: resources/icon.png
+  target:
+    - target: nsis
+      arch: [x64]
+    - target: portable
+      arch: [x64]
+  verifyUpdateCodeSignature: false
+
+nsis:
+  oneClick: false
+  allowToChangeInstallationDirectory: true
+  deleteAppDataOnUninstall: false
+  createDesktopShortcut: true
+  createStartMenuShortcut: true
+  shortcutName: omp
+
+# Upstream's electron-builder.yml points the updater at nornzach/oh-my-pi-gui,
+# which ships no latest.yml for Windows, so every in-app update check 404s.
+# electron-builder turns this into resources/app-update.yml (the feed the
+# installed app reads) and emits latest.yml next to the installers; the release
+# is still created by the workflow (--publish never uploads nothing).
+publish:
+  provider: github
+  owner: nocodeworldbug
+  repo: omp-gui-win
+
+portable:
+  artifactName: ${productName}-${version}-portable.${ext}
